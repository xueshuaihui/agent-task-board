// 数据契约来源：PRD v1.5 十一章（DDL）与二十章（枚举/默认值）。
// 迁移 SQL 是权威定义（含 CHECK 与部分索引，Prisma schema 无法表达），
// 因此本文件只做客户端映射，改动时必须同步 prisma/migrations/*.sql。
// 上线/开发一律用 `prisma migrate deploy`，不要用 `migrate dev`（它会试图按本文件重算 DDL，丢掉 CHECK 与部分索引）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id
  username           String  @unique
  passwordHash       String  @default("") @map("password_hash")
  salt               String  @default("")
  algo               String  @default("scrypt")
  role               String  @default("MEMBER")
  status             String  @default("ACTIVE")
  mustChangePassword Int     @default(0) @map("must_change_password")
  displayName        String? @map("display_name")
  createdAt          String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt          String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  preferences UserPreference[]
  projects    Project[]

  @@map("accounts")
}

// value 是 JSON 文本，客户端自行 parse/stringify（SQLite 无 JSON 列型）。
model UserPreference {
  accountId String  @map("account_id")
  key       String
  value     String  @default("{}")
  updatedAt String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, key])
  @@map("user_preferences")
}

model Project {
  id          String  @id
  accountId   String  @map("account_id")
  name        String
  color       String?
  icon        String?
  description String?
  status      String  @default("ACTIVE")
  sort        Int     @default(0)
  createdAt   String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt   String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")
  account     Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([accountId, status, sort], map: "idx_projects_account")
  @@map("projects")
}

model Task {
  id                   String    @id
  accountId            String    @default("acct_local") @map("account_id")
  project              Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId            String?   @map("project_id")
  parent               Task?     @relation("ParentChild", fields: [parentTaskId], references: [id])
  parentTaskId         String?   @map("parent_task_id")
  children             Task[]    @relation("ParentChild")
  sortOrder            Int       @default(0) @map("sort_order")
  type                 String    @default("需求")
  title                String
  description          String?
  status               String    @default("BACKLOG")
  priority             Int       @default(3)
  tags                 String?   @default("[]")
  requiredCapabilities String?   @default("[]") @map("required_capabilities")
  skills               String    @default("[]")
  customFields         String?   @default("{}") @map("custom_fields")
  pinned               Int       @default(0)
  dueAt                String?   @map("due_at")
  archivedAt           String?   @map("archived_at")
  leaseId              String?   @map("lease_id")
  leaseExpiresAt       String?   @map("lease_expires_at")
  leaseRevokedAt       String?   @map("lease_revoked_at")
  stopReason           String?   @map("stop_reason")
  currentRunId         String?   @map("current_run_id")
  claimedAt            String?   @map("claimed_at")
  runCount             Int       @default(0) @map("run_count")
  createdAt            String    @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt            String    @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  runs             TaskRun[]
  reviews          Review[]
  comments         Comment[]
  artifacts        Artifact[]
  notifications    Notification[]
  dependenciesFrom TaskDependency[]     @relation("Dependents")
  dependenciesTo   TaskDependency[]     @relation("Dependencies")

  @@index([accountId, archivedAt], map: "idx_tasks_account")
  @@index([projectId], map: "idx_tasks_project")
  @@index([parentTaskId], map: "idx_tasks_parent")
  @@index([status], map: "idx_tasks_status")
  @@index([status, pinned, priority, createdAt], map: "idx_tasks_ready")
  @@index([archivedAt], map: "idx_tasks_archived")
  @@map("tasks")
}

model TaskDependency {
  id         String   @id
  taskId     String   @map("task_id")
  dependsOn  String   @map("depends_on")
  type       String   @default("blocks")
  createdAt  String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task       Task     @relation("Dependents", fields: [taskId], references: [id], onDelete: Cascade)
  depends    Task     @relation("Dependencies", fields: [dependsOn], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOn])
  @@index([taskId], map: "idx_deps_task")
  @@index([dependsOn], map: "idx_deps_depends_on")
  @@map("task_dependencies")
}

model TaskTemplate {
  id          String   @id
  accountId   String   @default("acct_local") @map("account_id")
  name        String
  description String?
  preset      String
  sortOrder   Int?     @map("sort_order")
  createdAt   String   @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@index([accountId], map: "idx_templates_account")
  @@map("task_templates")
}

model CustomFieldDef {
  id           String   @id
  accountId    String   @default("acct_local") @map("account_id")
  key          String   @unique
  label        String
  type         String
  required     Int      @default(0)
  defaultValue String?  @map("default_value")
  options      String?
  appliesTo    String?  @default("[]") @map("applies_to")
  showOnCard   Int      @default(0) @map("show_on_card")
  sortOrder    Int?     @map("sort_order")
  enabled      Int      @default(1)
  createdAt    String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt    String   @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@map("custom_field_defs")
}

model TaskRun {
  id           String    @id
  taskId       String    @map("task_id")
  agentName    String?   @map("agent_name")
  tokenId      String?   @map("token_id")
  runNumber    Int       @map("run_number")
  status       String    @default("RUNNING")
  triggerType  String    @default("agent_poll") @map("trigger_type")
  leaseId      String?   @map("lease_id")
  startedAt    String    @default(dbgenerated("(datetime('now'))")) @map("started_at")
  finishedAt   String?   @map("finished_at")
  durationMs   Int?      @map("duration_ms")
  output       String?
  summary      String?
  error        String?
  progress     Int?
  progressMsg  String?   @map("progress_msg")
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  token        ApiToken? @relation(fields: [tokenId], references: [id])
  artifacts    Artifact[]
  comments     Comment[]

  @@unique([taskId, runNumber])
  @@index([taskId], map: "idx_runs_task")
  @@map("task_runs")
}

model Artifact {
  id         String   @id
  runId      String   @map("run_id")
  taskId     String   @map("task_id")
  type       String
  uri        String
  sizeBytes  Int?     @map("size_bytes")
  mimeType   String?  @map("mime_type")
  metadata   String?  @default("{}")
  createdAt  String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  run        TaskRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId], map: "idx_artifacts_run")
  @@map("artifacts")
}

model Review {
  id          String   @id
  taskId      String   @map("task_id")
  runId       String?  @map("run_id")
  conclusion  String
  suggestion  String
  reason      String
  detail      String
  returnTo    String?  @map("return_to")
  priorityAdj Int?     @map("priority_adj")
  createdAt   String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt], map: "idx_reviews_task")
  @@map("reviews")
}

model Comment {
  id         String   @id
  taskId     String   @map("task_id")
  runId      String?  @map("run_id")
  authorType String   @map("author_type")
  authorName String?  @map("author_name")
  type       String   @default("comment")
  content    String
  createdAt  String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run        TaskRun? @relation(fields: [runId], references: [id])

  @@map("comments")
}

model ApiToken {
  id           String    @id
  accountId    String    @default("acct_local") @map("account_id")
  name         String
  tokenHash    String    @unique @map("token_hash")
  capabilities String?   @default("[]")
  enabled      Int       @default(1)
  lastUsedAt   String?   @map("last_used_at")
  createdAt    String    @default(dbgenerated("(datetime('now'))")) @map("created_at")
  runs         TaskRun[]

  @@index([accountId], map: "idx_tokens_account")
  @@map("api_tokens")
}

model Setting {
  key       String @id
  value     String
  updatedAt String @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actorType  String   @map("actor_type")
  actorName  String?  @map("actor_name")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  before     String?
  after      String?
  createdAt  String   @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@map("audit_logs")
}

model IdSequence {
  name String @id
  next Int    @default(1000)

  @@map("id_sequences")
}

model Notification {
  id        String   @id
  accountId String   @default("acct_local") @map("account_id")
  kind      String
  taskId    String?  @map("task_id")
  message   String
  readAt    String?  @map("read_at")
  createdAt String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([accountId, readAt], map: "idx_notif_account")
  @@map("notifications")
}

// 0919：技能管理（迁移 0003_skills）。JSON 列是文本，客户端 parse/stringify。
model Skill {
  id              String  @id
  accountId       String  @map("account_id")
  name            String
  type            String
  status          String  @default("DRAFT")
  description     String  @default("")
  tags            String  @default("[]")
  currentVersion  String  @default("v0.1.0") @map("current_version")
  content         String  @default("{\"blocks\":[],\"entryBlockId\":null}")
  testCases       String  @default("[]") @map("test_cases")
  mcpDependencies String  @default("[]") @map("mcp_dependencies")
  // 8.8 技能源：local（本地创作）/ market（市场订阅落地）/ builtin / git / http / directory
  source          String  @default("local") @map("source")
  createdAt       String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt       String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")
  versions        SkillVersion[]

  @@index([accountId, status], map: "idx_skills_account")
  @@unique([accountId, name], map: "uniq_skills_account_name")
  @@map("skills")
}

model SkillVersion {
  id              String @id
  skillId         String @map("skill_id")
  version         String
  content         String @default("{\"blocks\":[],\"entryBlockId\":null}")
  testCases       String @default("[]") @map("test_cases")
  mcpDependencies String @default("[]") @map("mcp_dependencies")
  changelog       String @default("")
  createdAt       String @default(dbgenerated("(datetime('now'))")) @map("created_at")
  skill           Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@index([skillId], map: "idx_skill_versions_skill")
  @@map("skill_versions")
}

// ---------------------------------------------------------------- 市场（0919 九章）

// 注意：市场各表的 account_id / listing_id / skill_id 只声明为标量列（FK 约束在迁移 SQL 里），
// 不建 Prisma relation，避免反向污染 Account/Skill 模型；关联查询由服务层手写。
model MarketListing {
  id                 String  @id
  slug               String  @unique(map: "uniq_market_listings_slug")
  name               String
  description        String  @default("")
  category           String  @default("")
  tags               String  @default("[]")
  type               String
  source             String  @default("published")
  // 0919 云端市场：云端来源影子 listing / 本地发布上云后记云端 listing id
  cloudListingId     String? @map("cloud_listing_id")
  license            String  @default("")
  compatibleClients  String  @default("[]") @map("compatible_clients")
  content            String  @default("{\"blocks\":[],\"entryBlockId\":null}")
  mcpDependencies    String  @default("[]") @map("mcp_dependencies")
  currentVersion     String  @default("v0.1.0") @map("current_version")
  publisherAccountId String? @map("publisher_account_id")
  status             String  @default("PENDING_REVIEW")
  reviewNote         String  @default("") @map("review_note")
  ratingAvg          Float   @default(0) @map("rating_avg")
  ratingCount        Int     @default(0) @map("rating_count")
  subscriberCount    Int     @default(0) @map("subscriber_count")
  viewCount          Int     @default(0) @map("view_count")
  publishedAt        String? @map("published_at")
  createdAt          String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt          String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@index([status, category], map: "idx_market_listings_status")
  @@index([publisherAccountId], map: "idx_market_listings_publisher")
  @@map("market_listings")
}

model MarketSubscription {
  accountId       String @map("account_id")
  listingId       String @map("listing_id")
  snapshotContent String @default("{\"blocks\":[],\"entryBlockId\":null}") @map("snapshot_content")
  snapshotVersion String @default("") @map("snapshot_version")
  status          String @default("SYNCED")
  skillId         String? @map("skill_id")
  createdAt       String @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@unique([accountId, listingId], map: "market_subscriptions_account_id_listing_id_key")
  @@index([accountId, status], map: "idx_market_subscriptions_account")
  @@map("market_subscriptions")
}

model MarketRating {
  accountId String @map("account_id")
  listingId String @map("listing_id")
  score     Int
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt String @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@unique([accountId, listingId], map: "market_ratings_account_id_listing_id_key")
  @@map("market_ratings")
}

model MarketComment {
  id        String @id
  accountId String @map("account_id")
  listingId String @map("listing_id")
  content   String
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@index([listingId], map: "idx_market_comments_listing")
  @@map("market_comments")
}

model MarketFavorite {
  accountId String @map("account_id")
  listingId String @map("listing_id")
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@unique([accountId, listingId], map: "market_favorites_account_id_listing_id_key")
  @@map("market_favorites")
}

model MarketReport {
  id        String @id
  accountId String @map("account_id")
  listingId String @map("listing_id")
  reason    String
  status    String @default("OPEN")
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@map("market_reports")
}

model MarketFeedback {
  id             String  @id
  accountId      String  @map("account_id")
  listingId      String  @map("listing_id")
  title          String
  content        String  @default("")
  status         String  @default("PENDING")
  authorResponse String  @default("") @map("author_response")
  createdAt      String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  respondedAt    String? @map("responded_at")

  @@index([accountId], map: "idx_market_feedbacks_account")
  @@index([listingId], map: "idx_market_feedbacks_listing")
  @@map("market_feedbacks")
}
