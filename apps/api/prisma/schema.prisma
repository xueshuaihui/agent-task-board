// 数据契约来源：PRD v1.5 十一章（DDL）与二十章（枚举/默认值）。
// 迁移 SQL 是权威定义（含 CHECK 与部分索引，Prisma schema 无法表达），
// 因此本文件只做客户端映射，改动时必须同步 prisma/migrations/*.sql。
// 上线/开发一律用 `prisma migrate deploy`，不要用 `migrate dev`（它会试图按本文件重算 DDL，丢掉 CHECK 与部分索引）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// v0.0.4 W1a：账号体系与服务端市场已移除（见 docs/v0.0.4/需求.md §21.1）——
// 全表去 account_id、删 accounts 与 market_* 表；本地单用户，鉴权只认 token。

// value 是 JSON 文本，客户端自行 parse/stringify（SQLite 无 JSON 列型）。
model UserPreference {
  key       String @id
  value     String @default("{}")
  updatedAt String @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@map("user_preferences")
}

// v0.0.4 W1b：术语迁移 Project→Group（需求.md §21.1）——表 `projects`→`groups`、
// `tasks.project_id`→`group_id`，索引随之改名；列语义未变。
// v0.0.4 W1-D1（§5.2/§19）：`is_default` 标记预置「默认」分组（0009 迁移植入固定行
// `grp_default`），不可删、不可归档；「至多一行 is_default=1」由服务层保证。
// v0.0.4 W4（§5.6/§15.1，0011 迁移）：`archived_at` 归档时间戳，与 `status`（ACTIVE/ARCHIVED）
// 配对——status 是过滤谓词，archived_at 记录归档时刻；反归档清回 NULL。
model Group {
  id        String  @id
  name      String
  color     String?
  icon      String?
  description String?
  status    String  @default("ACTIVE")
  sort      Int     @default(0)
  isDefault Int     @default(0) @map("is_default")
  archivedAt  String? @map("archived_at")
  createdAt   String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt   String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")
  tasks       Task[]

  @@unique([name], map: "uniq_groups_name")
  @@index([status, sort], map: "idx_groups_status")
  @@map("groups")
}

model Task {
  id                   String  @id
  group                Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId              String? @map("group_id")
  parent               Task?   @relation("ParentChild", fields: [parentTaskId], references: [id])
  parentTaskId         String? @map("parent_task_id")
  children             Task[]  @relation("ParentChild")
  sortOrder            Int     @default(0) @map("sort_order")
  type                 String  @default("需求")
  title                String
  description          String?
  status               String  @default("BACKLOG")
  priority             Int     @default(3)
  tags                 String? @default("[]")
  requiredCapabilities String? @default("[]") @map("required_capabilities")
  skills               String  @default("[]")
  customFields         String? @default("{}") @map("custom_fields")
  pinned               Int     @default(0)
  dueAt                String? @map("due_at")
  archivedAt           String? @map("archived_at")
  // v0.0.4 W7 §15.1/0012：拆解会话来源标记，确认创建时写入；不建外键关系字段（同 parent_task_id 语义松散）。
  breakdownSessionId   String? @map("breakdown_session_id")
  // v0.0.4 W8 §8.9/0013：任务来源五列（§20 全量表）。origin_type 默认 user；
  // board.create_task 建的任务落 agent + session/agent 标识 + 当次 confirmation_mode。
  originType      String? @default("user") @map("origin_type")
  originAgent     String? @map("origin_agent")
  originSkill     String? @map("origin_skill")
  originSessionId String? @map("origin_session_id")
  confirmationMode String? @map("confirmation_mode")
  leaseId              String? @map("lease_id")
  leaseExpiresAt       String? @map("lease_expires_at")
  leaseRevokedAt       String? @map("lease_revoked_at")
  stopReason           String? @map("stop_reason")
  currentRunId         String? @map("current_run_id")
  claimedAt            String? @map("claimed_at")
  runCount             Int     @default(0) @map("run_count")
  createdAt            String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt            String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  runs             TaskRun[]
  reviews          Review[]
  comments         Comment[]
  artifacts        Artifact[]
  notifications    Notification[]
  dependenciesFrom TaskDependency[] @relation("Dependents")
  dependenciesTo   TaskDependency[] @relation("Dependencies")

  @@index([groupId], map: "idx_tasks_group")
  @@index([parentTaskId], map: "idx_tasks_parent")
  @@index([status], map: "idx_tasks_status")
  @@index([status, pinned, priority, createdAt], map: "idx_tasks_ready")
  @@index([archivedAt], map: "idx_tasks_archived")
  @@map("tasks")
}

model TaskDependency {
  id        String @id
  taskId    String @map("task_id")
  dependsOn String @map("depends_on")
  type      String @default("blocks")
  createdAt String @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task      Task   @relation("Dependents", fields: [taskId], references: [id], onDelete: Cascade)
  depends   Task   @relation("Dependencies", fields: [dependsOn], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOn])
  @@index([taskId], map: "idx_deps_task")
  @@index([dependsOn], map: "idx_deps_depends_on")
  @@map("task_dependencies")
}

model TaskTemplate {
  id          String  @id
  name        String
  description String?
  preset      String
  sortOrder   Int?    @map("sort_order")
  createdAt   String  @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@map("task_templates")
}

model CustomFieldDef {
  id           String  @id
  key          String  @unique
  label        String
  type         String
  required     Int     @default(0)
  defaultValue String? @map("default_value")
  options      String?
  appliesTo    String? @default("[]") @map("applies_to")
  showOnCard   Int     @default(0) @map("show_on_card")
  sortOrder    Int?    @map("sort_order")
  enabled      Int     @default(1)
  createdAt    String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt    String  @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@map("custom_field_defs")
}

model TaskRun {
  id          String     @id
  taskId      String     @map("task_id")
  agentName   String?    @map("agent_name")
  tokenId     String?    @map("token_id")
  runNumber   Int        @map("run_number")
  status      String     @default("RUNNING")
  triggerType String     @default("agent_poll") @map("trigger_type")
  leaseId     String?    @map("lease_id")
  startedAt   String     @default(dbgenerated("(datetime('now'))")) @map("started_at")
  finishedAt  String?    @map("finished_at")
  durationMs  Int?       @map("duration_ms")
  output      String?
  summary     String?
  error       String?
  progress    Int?
  progressMsg String?    @map("progress_msg")
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  token       ApiToken?  @relation(fields: [tokenId], references: [id])
  artifacts   Artifact[]
  comments    Comment[]

  @@unique([taskId, runNumber])
  @@index([taskId], map: "idx_runs_task")
  @@map("task_runs")
}

model Artifact {
  id        String  @id
  runId     String  @map("run_id")
  taskId    String  @map("task_id")
  type      String
  uri       String
  sizeBytes Int?    @map("size_bytes")
  mimeType  String? @map("mime_type")
  metadata  String? @default("{}")
  createdAt String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  run       TaskRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([runId], map: "idx_artifacts_run")
  @@map("artifacts")
}

model Review {
  id          String  @id
  taskId      String  @map("task_id")
  runId       String? @map("run_id")
  conclusion  String
  suggestion  String
  reason      String
  detail      String
  returnTo    String? @map("return_to")
  priorityAdj Int?    @map("priority_adj")
  createdAt   String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task        Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt], map: "idx_reviews_task")
  @@map("reviews")
}

model Comment {
  id         String   @id
  taskId     String   @map("task_id")
  runId      String?  @map("run_id")
  authorType String   @map("author_type")
  authorName String?  @map("author_name")
  type       String   @default("comment")
  content    String
  createdAt  String   @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run        TaskRun? @relation(fields: [runId], references: [id])

  @@map("comments")
}

model ApiToken {
  id           String    @id
  name         String
  tokenHash    String    @unique @map("token_hash")
  capabilities String?   @default("[]")
  enabled      Int       @default(1)
  lastUsedAt   String?   @map("last_used_at")
  createdAt    String    @default(dbgenerated("(datetime('now'))")) @map("created_at")
  runs         TaskRun[]

  @@map("api_tokens")
}

model Setting {
  key       String @id
  value     String
  updatedAt String @default(dbgenerated("(datetime('now'))")) @map("updated_at")

  @@map("settings")
}

model AuditLog {
  id         Int     @id @default(autoincrement())
  actorType  String  @map("actor_type")
  actorName  String? @map("actor_name")
  action     String
  targetType String  @map("target_type")
  targetId   String? @map("target_id")
  before     String?
  after      String?
  createdAt  String  @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@map("audit_logs")
}

model IdSequence {
  name String @id
  next Int    @default(1000)

  @@map("id_sequences")
}

model Notification {
  id        String  @id
  // 词表权威在迁移 CHECK（0001 五类 + 0014 追加 creation_request，§13.9 r3）；镜像列保持无约束 String。
  kind      String
  taskId    String? @map("task_id")
  message   String
  readAt    String? @map("read_at")
  createdAt String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([readAt], map: "idx_notif_read")
  @@map("notifications")
}

// 0919：技能管理（迁移 0003_skills）。JSON 列是文本，客户端 parse/stringify。
model Skill {
  id              String         @id
  name            String
  type            String
  status          String         @default("DRAFT")
  description     String         @default("")
  tags            String         @default("[]")
  currentVersion  String         @default("v0.1.0") @map("current_version")
  content         String         @default("{\"blocks\":[],\"entryBlockId\":null}")
  testCases       String         @default("[]") @map("test_cases")
  mcpDependencies String         @default("[]") @map("mcp_dependencies")
  // v0.0.4 W2（§9.1/§21.1）：三来源枚举 default（内置默认，只读）/ custom（用户创建）/
  // imported（三方导入）。旧 source 值（local/market/builtin/git/http/directory）已在
  // 0010 迁移收敛改写，r2：三方技能不保留「导入来源」记录。
  sourceType      String         @default("custom") @map("source_type")
  // 技能分类（0015 迁移加列，PRD §9.2 两字段模型）：单值受控词表 11 项 + ''（空串=未分类），
  // CHECK 的现行真值源在 0017 迁移（0925 拍板删「开学季」，重建 skills 表收敛词表；0015 的
  // 12 词 CHECK 只作历史回填口径）与 idx_skills_category 只在迁移 SQL 里（本文件表达不了）；
  // tags 自 0015 起退回纯自由标签，「官方/社区」受众维度作废（出处由上面的 sourceType 表达）。
  // 词表权威见 src/skills/skill-categories.ts。
  category        String         @default("")
  createdAt       String         @default(dbgenerated("(datetime('now'))")) @map("created_at")
  updatedAt       String         @default(dbgenerated("(datetime('now'))")) @map("updated_at")
  versions        SkillVersion[]

  // r2（§9.2/§21.1）：name 允许重名，唯一性只由 id（主键，终身不变）保证；
  // uniq_skills_name 已随 0010 迁移解除。
  @@index([status], map: "idx_skills_status")
  @@index([category], map: "idx_skills_category")
  @@map("skills")
}

model SkillVersion {
  id              String @id
  skillId         String @map("skill_id")
  version         String
  content         String @default("{\"blocks\":[],\"entryBlockId\":null}")
  testCases       String @default("[]") @map("test_cases")
  mcpDependencies String @default("[]") @map("mcp_dependencies")
  changelog       String @default("")
  createdAt       String @default(dbgenerated("(datetime('now'))")) @map("created_at")
  skill           Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@index([skillId], map: "idx_skill_versions_skill")
  @@map("skill_versions")
}

// v0.0.4 W7 需求拆解（§7.6/§7.7，迁移 0012）。三表逐条照搬 §7.6 DDL；
// status 取值全集见 §7.7（CHECK 只在迁移 SQL 里，本文件照旧只做客户端映射）。
// group_id / parent_task_id 是弱引用（§7.6 无级联语义），不建 Prisma 关系字段。
model BreakdownSession {
  id                String  @id
  requirementText   String  @map("requirement_text")
  groupId           String? @map("group_id")
  parentTitle       String  @map("parent_title")
  parentDescription String? @map("parent_description")
  parentTaskId      String? @map("parent_task_id")
  status            String  @default("receiving")
  agentName         String? @map("agent_name")
  skillUsed         String? @map("skill_used")
  estimatedTasks    Int?    @map("estimated_tasks")
  actualTasks       Int?    @map("actual_tasks")
  createdAt         String  @default(dbgenerated("(datetime('now'))")) @map("created_at")
  finishedAt        String? @map("finished_at")
  confirmedAt       String? @map("confirmed_at")
  cancelledAt       String? @map("cancelled_at")
  drafts            BreakdownDraft[]
  progress          BreakdownProgress[]

  @@map("breakdown_sessions")
}

model BreakdownDraft {
  id          String           @id
  session     BreakdownSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String           @map("session_id")
  ref         String
  title       String
  description String?
  priority    Int              @default(3)
  skillIds    String           @default("[]") @map("skill_ids")
  acceptance  String           @default("[]")
  dependsOn   String           @default("[]") @map("depends_on")
  sortOrder   Int              @default(0) @map("sort_order")

  @@unique([sessionId, ref])
  @@map("breakdown_drafts")
}

model BreakdownProgress {
  id        Int              @id @default(autoincrement())
  session   BreakdownSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String           @map("session_id")
  step      Int
  total     Int
  message   String?
  createdAt String           @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@map("breakdown_progress")
}

// v0.0.4 W8 会话创建闭环（§8.7 闭环语义 r3 / §8.9，迁移 0013）。
// agent_sessions：§8.7「按 session_id upsert，刷新 last_active_at/task_count」——
// session_id 是 Agent 侧会话标识（单列 UNIQUE），id 为内部主键（UUIDv7）。
model AgentSession {
  id           String @id
  sessionId    String @unique @map("session_id")
  agentName    String @map("agent_name")
  startedAt    String @default(dbgenerated("(datetime('now'))")) @map("started_at")
  lastActiveAt String @default(dbgenerated("(datetime('now'))")) @map("last_active_at")
  taskCount    Int    @default(0) @map("task_count")

  @@map("agent_sessions")
}

// task_creation_logs：每次创建/取消/超时各记一条（§8.7）；source/confirmation/user_action
// 是开放审计词表（CHECK 只在需要处收敛），task_id 无外键——撤销物理删任务后日志仍可读。
model TaskCreationLog {
  id           Int     @id @default(autoincrement())
  taskId       String  @map("task_id")
  sessionId    String? @map("session_id")
  agentName    String? @map("agent_name")
  source       String
  confirmation String?
  userAction   String? @map("user_action")
  createdAt    String  @default(dbgenerated("(datetime('now'))")) @map("created_at")

  @@index([taskId], map: "idx_creation_logs_task")
  @@index([sessionId], map: "idx_creation_logs_session")
  @@map("task_creation_logs")
}
