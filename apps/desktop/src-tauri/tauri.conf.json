{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis Workbench",
  "version": "0.1.0",
  "identifier": "dev.jarvisworkbench.desktop",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "publisher": "Jarvis Workbench",
    "category": "Productivity",
    "shortDescription": "本地桌面任务看板：人建任务，Agent 认领执行，结果强制人工审核",
    "longDescription": "Jarvis Workbench 桌面壳：Tauri 2 主窗口 + 托盘，托管仅监听 127.0.0.1 的 Node sidecar（REST / MCP / WebSocket）。",
    "copyright": "© Jarvis Workbench",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "resources": {
      "resources/sidecar": "sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
