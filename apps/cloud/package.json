    "test": "vitest run",
    "prisma": "node scripts/db.mjs",
    "db:deploy": "node scripts/db.mjs migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/client": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.2",
    "prisma": "^6.19.3",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.0",
    "vitest": "^3.0.0"
  }
}
