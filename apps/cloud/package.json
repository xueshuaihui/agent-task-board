{
  "name": "@atb/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "云端技能市场服务：独立部署，账号 + 市场共享全流程（本期不含任务/看板）",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
