# Agent Task Board 云端市场 · 生产环境配置模板
#
# 用法：cp .env.prod.example .env.prod 后填写，或直接执行 ./deploy.sh（首次部署会自动生成并补齐）。
# .env.prod 已不入库，切勿提交。
#
# 硬约束：这里所有值必须是生产专用；deploy.sh 会在启动前拦截模板占位值与弱密钥。

# ---- 服务端 ----
# CLOUD_JWT_SECRET 留空时 deploy.sh 首次部署会自动生成 64 位随机密钥并写回本文件。
# 更换或丢失该密钥会使所有已登录会话失效（需重新登录）；**该值不可再生，请连同本文件一起备份**。
CLOUD_JWT_SECRET=
# 允许的跨域来源，逗号分隔：桌面端 WebView 来源（tauri://localhost、http://tauri.localhost 等）
# 与网页端来源。经 caddy 同域反代时桌面端仍直连本域名，需要列出；留空 = 放行任意来源（公开市场默认）。
CLOUD_CORS_ORIGINS=
# 置 1 打印 Prisma 查询日志（排障用，平时留空）
CLOUD_SQL_LOG=

# ---- 边缘层：谁终止 TLS / 谁占着 80/443 ----
# caddy（默认）= 本编排自带 caddy 服务（compose profile "edge"）独占宿主机 80/443，
#                自动向 Let's Encrypt 申请并续签证书，把全站反代到 cloud:7789。
#                前提：域名 A 记录已指向本机，且公网 80/443 可达（ACME HTTP-01 验证需要）。
#                此时下面 SITE_DOMAIN / ACME_EMAIL 必填。
# off          = 宿主机 80/443 已被别的边缘占用（1Panel 的 OpenResty、n8n 等），不要硬抢：
#                caddy 不进编排，在既有边缘建一个站点反代到 http://HTTP_BIND:HTTP_PORT
#                （默认 127.0.0.1:7789），证书交给该边缘签发。此时 SITE_DOMAIN / ACME_EMAIL 允许留空。
# 改动 EDGE_MODE 后重跑 ./deploy.sh update（或 up）即可生效（脚本会同步 COMPOSE_PROFILES）。
EDGE_MODE=caddy
COMPOSE_PROFILES=edge

# EDGE_MODE=caddy 时必填：域名与 ACME 注册邮箱
SITE_DOMAIN=cloud.example.com
ACME_EMAIL=admin@example.com
# 留空走 Let's Encrypt 生产 CA；测试期取消下面这行注释可避免触发生产速率限制（证书为 staging 自签，浏览器会告警）：
# ACME_CA_BLOCK=acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

# cloud 容器的绑定地址：EDGE_MODE=caddy 时保持回环（公网流量经 caddy 进来）；
# EDGE_MODE=off 时正是外部边缘要反代的地址，通常也保持 127.0.0.1。
HTTP_BIND=127.0.0.1
HTTP_PORT=7789
# 备份落盘目录：相对路径按编排目录解析；建议写绝对路径（如 /opt/agent-task-board-cloud/backups）
BACKUP_DIR=./backups
# 备份保留份数（超过即清理最旧的）
BACKUP_KEEP=14
