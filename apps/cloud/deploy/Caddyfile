# Agent Task Board 云端市场 · Caddy 边缘配置（挂载到 /etc/caddy/Caddyfile）
# 自动向 Let's Encrypt 申请并续签证书，把全站反代到 cloud:7789。
# 变量由 compose 通过 environment 注入：{$SITE_DOMAIN} / {$ACME_EMAIL} / {$ACME_CA_BLOCK}

{
	# Let's Encrypt 注册邮箱（证书过期提醒、账户绑定）
	email {$ACME_EMAIL}
	# 测试期置为 staging CA 可避免触发生产速率限制；留空走生产 CA
	{$ACME_CA_BLOCK}
}

{$SITE_DOMAIN} {
	encode gzip

	# 安全响应头（HSTS 让浏览器强制 HTTPS）
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# 全站反代到 cloud 容器（请求体上限：服务端 JSON 限额 2MB，这里放宽到 4m 余量）
	reverse_proxy cloud:7789 {
		header_up X-Forwarded-For {remote_host}
	}
	request_body {
		max_size 4MB
	}
}
